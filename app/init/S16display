#!/bin/sh
#
# Loads the driver for the 3.5" SPI display (the piscreen overlay in config.txt), which
# camera-server draws on through /dev/fb0. There is no mdev or udev to load it from the device
# tree alias, so it is loaded here, before camera-server starts. The kernel console is taken
# off the display, so it doesn't draw over the camera image.
#

FB=/dev/fb0

start() {
    printf "Loading display driver: "
    if ! modprobe spi_bcm2835 || ! modprobe fb_ili9486; then
        echo "FAIL"
        return 0
    fi

    # The framebuffer appears once the driver has initialized the display
    i=0
    while [ ! -c $FB ] && [ $i -lt 20 ]; do
        sleep 0.1
        i=$((i + 1))
    done
    if [ ! -c $FB ]; then
        echo "no display"
        return 0
    fi

    for vt in /sys/class/vtconsole/vtcon*; do
        if grep -q "frame buffer" $vt/name; then
            echo 0 > $vt/bind
        fi
    done
    echo "OK"
}

stop() {
    printf "Unloading display driver: "
    modprobe -r fb_ili9486 && echo "OK" || echo "FAIL"
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        stop
        start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

exit 0
