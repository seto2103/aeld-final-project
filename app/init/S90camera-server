#!/bin/sh

DAEMON=/usr/bin/camera-supervisor
DAEMON_OPTS="-d"

# camera-supervisor runs camera-server, starts it again after it exits and feeds the hardware
# watchdog. Both are found by executable path instead of a PID file.

start() {
    echo "Starting camera-server..."
    # No hotplug helper in this image, so load the USB webcam driver explicitly
    modprobe uvcvideo
    start-stop-daemon --start --exec $DAEMON -- $DAEMON_OPTS
}

stop() {
    echo "Stopping camera-server..."
    start-stop-daemon --stop --exec $DAEMON
    # BusyBox start-stop-daemon has no --retry. The supervisor gives camera-server 10 s to exit,
    # so wait up to 15 s for both to be gone.
    i=0
    while pidof camera-supervisor camera-server > /dev/null; do
        i=$((i + 1))
        if [ $i -gt 75 ]; then
            echo "camera-server did not stop"
            return 1
        fi
        sleep 0.2
    done
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        stop
        start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

exit 0
