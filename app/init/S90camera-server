#!/bin/sh

DAEMON=/usr/bin/camera-server
DAEMON_OPTS="-d"

# camera-server daemonizes itself with -d, so the process is found by name instead of a PID file

start() {
    echo "Starting camera-server..."
    # No hotplug helper in this image, so load the USB webcam driver explicitly
    modprobe uvcvideo
    start-stop-daemon --start --name camera-server --exec $DAEMON -- $DAEMON_OPTS
}

stop() {
    echo "Stopping camera-server..."
    start-stop-daemon --stop --name camera-server
    # BusyBox start-stop-daemon has no --retry, so wait up to 5 s for the process to exit
    i=0
    while pidof camera-server > /dev/null; do
        i=$((i + 1))
        if [ $i -gt 25 ]; then
            echo "camera-server did not stop"
            return 1
        fi
        sleep 0.2
    done
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        stop
        start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

exit 0
